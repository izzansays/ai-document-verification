# Convex Backend Configuration
# Get these values from your Convex dashboard: https://dashboard.convex.dev

# Convex deployment URL (required for frontend)
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Convex deployment key (not needed for frontend, only for CI/CD)
# CONVEX_DEPLOY_KEY=

# Convex deployment name (not needed for frontend)
# CONVEX_DEPLOYMENT=

# Anthropic API Configuration
# Get your API key from: https://console.anthropic.com/
# This is used by Convex backend actions (not the frontend)
ANTHROPIC_API_KEY=your-api-key-here

# Site URL (for local development)
# This is needed for Convex actions to fetch documents from your local server
# In production, set this to your deployed app URL
SITE_URL=http://localhost:5173
